{
    "name": "alantiller/database",
    "description": "A Medoo database wrapper with versioned migrations and database management for PHP",
    "type": "library",
    "license": "MIT",
    "authors": [{"name": "Alan Tiller", "email": "alan@alantiller.com"}],
    "require": {"php": ">=8.1", "ext-pdo": "*", "catfan/medoo": "^2.4"},
    "require-dev": {"phpstan/phpstan": "^2.1", "phpunit/phpunit": "^10.5"},
    "autoload": {"psr-4": {"Alantiller\\": "src/"}},
    "autoload-dev": {"psr-4": {"Alantiller\\Database\\Tests\\": "tests/"}},
    "bin": ["bin/database"],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "check": ["@analyse", "@test"]
    }
}
